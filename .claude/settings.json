{
  "permissions": {
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(net user:*)",
      "Bash(net localgroup:*)",
      "Bash(net1:*)",
      "Bash(reg add:*)",
      "Bash(reg delete:*)",
      "Bash(reg import:*)",
      "Bash(regedit:*)",
      "Bash(sc create:*)",
      "Bash(sc delete:*)",
      "Bash(sc config:*)",
      "Bash(schtasks:*)",
      "Bash(icacls:*)",
      "Bash(takeown:*)",
      "Bash(diskpart:*)",
      "Bash(bcdedit:*)",
      "Bash(bootrec:*)",
      "Bash(runas:*)",
      "Bash(sudo:*)",
      "Bash(rundll32:*)",
      "Bash(regsvr32:*)",
      "Bash(mshta:*)",
      "Bash(certutil:*)",
      "Bash(wmic:*)",
      "Bash(bitsadmin:*)",
      "Bash(cmdkey:*)",
      "Bash(vaultcmd:*)",
      "Bash(powershell -ExecutionPolicy:*)",
      "Bash(set-executionpolicy:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/authorized_keys)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/dev/guard_bash.sh\""
          }
        ]
      }
    ]
  }
}
