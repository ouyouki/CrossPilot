# 开发环境的设置(docs/运营规则.md 11 章)。
# 生成本机的副本: python scripts/dev/setup_env.py   (写到 docker/.env;<random> 会换成在本机生成的值)
# 这个示例里不要写真实的值;docker/.env 不要贴进聊天、评论或邮件。
COMPOSE_PROJECT_NAME=sample-dev
APP_PORT=8080
DB_NAME=app
DB_USER=app
DB_PASSWORD=<random>
TEST_DB_USER=app_test
TEST_DB_PASSWORD=<random>
APP_SECRET_KEY=<random>
